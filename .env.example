# -----------------------------------------------------------------------------
# ORVEX prototype: environment
# Copy to .env (or .env.local) and adjust. Nothing here is secret.
#
# Production installation variables (DATABASE_URL, LICENSE_KEY, ENCRYPTION_KEY…)
# are NOT used by the prototype; they live in deploy/.env.example.
# -----------------------------------------------------------------------------

# ---- Build time (inlined into the bundle by Vite) ----------------------------
# mock = in-browser mock backends with seeded data and live simulation (default)
# http = real HTTP calls to the two backends below
VITE_API_MODE=mock

# The customer's own installation admin API (relative = same origin as the SPA).
VITE_INSTALLATION_API_URL=/api/admin

# The vendor platform API (account, subscription, license, releases, support).
VITE_VENDOR_API_URL=https://account.orvex.io/api

# ---- Runtime (npm start / server/server.mjs) ----------------------------------
PORT=8080
HOST=127.0.0.1
# Extra origins allowed in the CSP connect-src (space separated), e.g. when
# VITE_API_MODE=http talks to a backend on another origin.
# CSP_CONNECT_SRC=https://staging-api.example.com
