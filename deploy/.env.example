# =============================================================================
#  ORVEX Core: installation configuration
#
#  Copy to .env, replace EVERY placeholder, then `chmod 600 .env`.
#  All values below are fake examples. Never commit the real file.
#  Secrets live only here (or in your secret manager) — never in the database,
#  never sent to ORVEX Systems.
# =============================================================================

# ---- Release ------------------------------------------------------------------
# Managed by the updater (orvexctl update). Do not edit during an update.
CORE_VERSION=2.5.0
# stable | beta  (beta requires a plan with the beta channel)
UPDATE_CHANNEL=stable
RELEASE_SERVER_URL=https://releases.orvex.io

# ---- Application -------------------------------------------------------------
NODE_ENV=production
APP_URL=https://portal.example.com
# Host name Caddy requests a certificate for (must match APP_URL)
APP_DOMAIN=portal.example.com
ACME_EMAIL=ops@example.com
# production | staging (must match the environment of the licensed domain)
INSTALLATION_ENV=production
LOG_LEVEL=info
# Requests reach core-api through Caddy only
TRUST_PROXY=1

# ---- Database (PostgreSQL 14 – 17, any provider) ------------------------------
# Bundled PostgreSQL (profile bundled-db), private Docker network:
DATABASE_URL=postgres://orvex:CHANGE_ME_DB_PASSWORD@postgres:5432/orvex
# Managed examples (see README § Database options):
#   Self-hosted : postgres://orvex:CHANGE_ME@10.0.0.5:5432/orvex
#   Supabase    : postgres://postgres.abcdefghijklmnopqrst:CHANGE_ME@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#   Neon        : postgres://orvex_owner:CHANGE_ME@ep-example-123456-pooler.eu-central-1.aws.neon.tech/orvex
#   AWS RDS     : postgres://orvex:CHANGE_ME@orvex.abc123xyz.eu-central-1.rds.amazonaws.com:5432/orvex
#   Hetzner     : postgres://orvex:CHANGE_ME@10.0.1.2:5432/orvex
#
# Optional non-pooled URL used for migrations, advisory locks and LISTEN/NOTIFY
# when DATABASE_URL points at a transaction-mode pooler (Supabase :6543, Neon -pooler).
DATABASE_DIRECT_URL=
# Schema that holds all Core tables (created by the installer if missing)
DATABASE_SCHEMA=orvex
# Max connections per Core process (api, worker, scheduler each hold a pool)
DATABASE_POOL_MAX=20
# disable | require | verify-full   (overrides sslmode in DATABASE_URL when set)
# Use disable only for the bundled database on the private Docker network.
DATABASE_SSL_MODE=disable
# CA bundle for verify-full with a private CA (mounted into /var/lib/orvex)
DATABASE_SSL_CA_FILE=

# Bundled database only (profile bundled-db)
COMPOSE_PROFILES=bundled-db
POSTGRES_DB=orvex
POSTGRES_USER=orvex
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---- License -------------------------------------------------------------------
# From account.orvex.io → License. Bound to APP_DOMAIN on activation.
LICENSE_KEY=LX-0000-XXXX-XXXX-XXXX
LICENSE_SERVER_URL=https://license.orvex.io
# minimal | off — optional daily heartbeat (installation id, versions, health,
# license-relevant counters). No business data is ever sent.
TELEMETRY_HEARTBEAT=minimal

# ---- Security --------------------------------------------------------------------
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Encrypts provider credentials, webhook secrets, MFA secrets and sensitive
# order inputs. LOSING THIS KEY MAKES THOSE VALUES UNRECOVERABLE — store a copy
# in your password manager / secret store, separately from database backups.
ENCRYPTION_KEY=base64:REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32
ENCRYPTION_KEY_ID=k1
# During key rotation: previous keys as id:base64 pairs, comma separated
ENCRYPTION_KEYS_PREVIOUS=
# 64+ random characters. Generate with:  openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32

# ---- Storage (uploads, exports, local backups) -------------------------------------
# local | s3 (any S3-compatible service: AWS S3, MinIO, Hetzner Object Storage, R2…)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/lib/orvex/storage
S3_ENDPOINT=https://s3.eu-central-1.example.com
S3_REGION=eu-central-1
S3_BUCKET=orvex-portal-example
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# ---- Email -----------------------------------------------------------------------
SMTP_URL=smtp://USERNAME:CHANGE_ME@smtp.example.com:587
MAIL_FROM="Example Platform <no-reply@example.com>"

# ---- Queue & workers -------------------------------------------------------------
# Concurrent jobs per core-worker container
QUEUE_WORKERS=4
# Polling fallback when LISTEN/NOTIFY is unavailable (poolers)
QUEUE_POLL_INTERVAL_MS=1000

# ---- Backups ---------------------------------------------------------------------
# Nightly backup schedule (cron, UTC) and retention
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAYS=14
# Where backups go: storage (STORAGE_DRIVER target) | local (core-data volume)
BACKUP_TARGET=storage
# Optional age/X25519 recipient: backups are encrypted to this public key.
BACKUP_ENCRYPTION_RECIPIENT=
