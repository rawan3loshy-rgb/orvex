# =============================================================================
#  ORVEX Core: reverse proxy (Caddy 2.8)
#
#  Automatic HTTPS for {$APP_DOMAIN} via ACME (Let's Encrypt / ZeroSSL).
#  The DNS A/AAAA record must point at this server and ports 80/443 must be
#  reachable for the first certificate. For internal-only installations,
#  replace the site address with `{$APP_DOMAIN} { tls internal … }` or mount
#  your own certificate (`tls /certs/fullchain.pem /certs/privkey.pem`).
#
#  Everything is proxied to core-api, which serves:
#    /                    public website (published snapshot)
#    /admin               admin SPA
#    /api/admin/*         admin API (session cookie)
#    /api/v1/*            Reseller API (API keys)
#    /hooks/providers/*   inbound provider callbacks
#    /healthz             liveness (minimal JSON)
# =============================================================================
{
	email {$ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2 h3
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Defence in depth; core-api sets its own CSP per surface (admin, site, API).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}

	# Internal endpoints are never exposed publicly.
	@internal path /readyz /metrics /metrics/*
	respond @internal 404

	# Request bodies (website assets, CSV imports, provider callbacks) are capped.
	request_body {
		max_size 25MB
	}

	reverse_proxy core-api:8080 {
		# Real client IP for rate limits, IP allow-lists and audit logs.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# Passive + active health checking; Caddy holds requests briefly
		# during a container restart instead of failing them.
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
		lb_try_duration 15s
		lb_try_interval 250ms

		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}

	log {
		output stdout
		format json
	}
}
